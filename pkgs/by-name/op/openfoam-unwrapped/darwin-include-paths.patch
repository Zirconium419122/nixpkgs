diff --git a/wmake/rules/darwin64Clang/general b/wmake/rules/darwin64Clang/general
--- a/wmake/rules/darwin64Clang/general
+++ b/wmake/rules/darwin64Clang/general
@@ -3,6 +3,14 @@ CPP        = cpp -traditional-cpp $(GFLAGS)
 include $(GENERAL_RULES)/standard
 ## include $(GENERAL_RULES)/Clang/openmp
-
+
+# Keep project include directories in their original order and make them
+# quote-only so OpenFOAM headers cannot shadow system headers.
+# wmkdepend still consumes the original -I options.
+darwin-include = $(if $(filter $(WM_PROJECT_DIR) $(WM_PROJECT_DIR)/% %/lnInclude,$(abspath $(1))),-iquote$(1),-I$(1))
+
+DARWIN_COMPILER_INCLUDES = -iquote. $(foreach flag,$(filter-out -iquote.,$(LIB_HEADER_DIRS)),\
+    $(if $(filter -I%,$(flag)),$(call darwin-include,$(patsubst -I%,%,$(flag))),$(flag)))
+
 # Darwin-specific
 # ----
 COMP_OPENMP = -Xpreprocessor -fopenmp
diff --git a/wmake/rules/darwin64Clang/c b/wmake/rules/darwin64Clang/c
--- a/wmake/rules/darwin64Clang/c
+++ b/wmake/rules/darwin64Clang/c
@@ -14,8 +14,8 @@ endif
 cFLAGS      = \
     $(cARCH) $(GFLAGS) $(cWARN) $(cOPT) $(cDBUG) \
-    $(FOAM_EXTRA_CFLAGS) $(LIB_HEADER_DIRS) -fPIC
-
+    $(FOAM_EXTRA_CFLAGS) $(DARWIN_COMPILER_INCLUDES) -fPIC
+
 ctoo        = $(WM_SCHEDULER) $(cc) $(cFLAGS) -c $< -o $@
-
+
 # MacOS linking
 include $(ARCHITECTURE_RULES)/link-c
diff --git a/wmake/rules/darwin64Clang/c++ b/wmake/rules/darwin64Clang/c++
--- a/wmake/rules/darwin64Clang/c++
+++ b/wmake/rules/darwin64Clang/c++
@@ -14,6 +14,6 @@ endif
 c++FLAGS    = \
     $(c++ARCH) $(GFLAGS) $(c++WARN) $(c++OPT) $(c++DBUG) $(ptFLAGS) \
-    $(FOAM_EXTRA_CXXFLAGS) $(LIB_HEADER_DIRS) -fPIC
-
+    $(FOAM_EXTRA_CXXFLAGS) $(DARWIN_COMPILER_INCLUDES) -fPIC
+
 Ctoo        = $(WM_SCHEDULER) $(CC) $(c++FLAGS) -c $< -o $@
 cctoo       = $(Ctoo)
